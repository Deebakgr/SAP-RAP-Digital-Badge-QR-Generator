@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'QR Code',
    typeNamePlural: 'QR Codes',
    title: { type: #STANDARD, value: 'QrId' },
     imageUrl: 'QrImage' 
  }
}
annotate view ZC_QR_DATA with 
{
  /* --- FACETS (Object Page Layout) --- */
  @UI.facet: [
    {
      id: 'QRInfo',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'QR Code Details',
      position: 10
    }
  ]

  /* --- FIELDS --- */

  @UI.lineItem: [{ position: 10, label: 'QR ID' }]
  @UI.identification: [{ position: 10, label: 'QR ID' }]
  QrId;

  @UI.hidden: true
  BadgeId;

  @UI.lineItem: [{ position: 20, label: 'QR Payload / Data' }]
  @UI.identification: [{ position: 20, label: 'QR Payload / Data' }]
  QrPayload;

  @UI.hidden: true
  MimeType;

  @UI.lineItem: [{ position: 30, label: 'QR Image' }]
  @UI.identification: [{ position: 30, label: 'QR Image' }]
  QrImage;

  @UI.identification: [{ position: 40, label: 'Generated By' }]
  CreatedBy;

  @UI.identification: [{ position: 50, label: 'Generated At' }]
  CreatedAt;
}